# ===== GitLab Stack Configuration =====
# These variables are used by both docker-compose.gitlab.yml and the helper scripts.

# GitLab edition
GITLAB_IMAGE=gitlab/gitlab-ce:latest

# Hostname used to reach GitLab from the host and from the runner
GITLAB_HOSTNAME=gitlab.local

# Published ports on the host
# 8080 -> 80  : Web UI + Git over HTTP
# 5050 -> 5050: Container Registry
# 2222 -> 22  : SSH
GITLAB_HTTP_PORT=8080
GITLAB_REGISTRY_PORT=5050
GITLAB_SSH_PORT=2222

# Persistent volume paths on the host
# Adjust these if you want GitLab data on a different disk.
GITLAB_CONFIG_PATH=./volumes/gitlab/config
GITLAB_LOGS_PATH=./volumes/gitlab/logs
GITLAB_DATA_PATH=./volumes/gitlab/data

# Runner token: leave empty to use the auto-registration flow
# (run scripts/run-lab.sh and pick option 3 once GitLab is up).
GITLAB_RUNNER_REGISTRATION_TOKEN=
GITLAB_RUNNER_NAME=local-runner

# Resource tuning (suitable for a developer workstation)
PUMA_WORKERS=2
SIDEKIQ_CONCURRENCY=10

# Set to "false" to disable embedded Prometheus (we disable by default to save RAM)
PROMETHEUS_ENABLED=false